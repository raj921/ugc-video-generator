ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PEXELS_API_KEY=
GIPHY_API_KEY=
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=
# Public base URL used for the audio asset Creatomate must fetch over the internet.
# Set to your deployed origin (e.g. https://your-app.vercel.app) so audio works from
# localhost too. If unset, prod uses the request origin; localhost falls back to the
# hardcoded FALLBACK_AUDIO_URL in lib/ugc/creatomate.ts (else audio is omitted, render still ok).
PUBLIC_MEDIA_BASE_URL=
